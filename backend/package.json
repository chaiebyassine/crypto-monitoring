{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "security": "snyk test",
    "security:report": "snyk test --json > snyk-report.json",
    "db:backup": "bash scripts/backup.sh",
    "db:backup:compressed": "bash scripts/backup.sh -c",
    "db:restore": "bash scripts/restore.sh",
    "db:restore:latest": "bash scripts/restore.sh --latest",
    "db:backups:list": "bash scripts/restore.sh --list",
    "db:init": "bash scripts/init-db.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "nock": "^14.0.10",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "snyk": "^1.1301.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
